# ── Kindroid Bot Configuration ──────────────────────────────────────────────
# Required only if you are running the Kindroid Discord bots
KINDROID_INFER_URL=https://api.kindroid.ai/v1/discord-bot
KINDROID_API_KEY=your_kindroid_api_key_here

# Add as many numbered sets as needed (1, 2, 3, ...)
# SHARED_AI_CODE_N + BOT_TOKEN_N are required per bot
SHARED_AI_CODE_1=your_shared_code_1_here
BOT_TOKEN_1=your_discord_bot_token_1_here
ENABLE_FILTER_1=false  # Optional: enable NSFW filtering

# Bot 2 (uncomment to add more bots)
# SHARED_AI_CODE_2=your_shared_code_2_here
# BOT_TOKEN_2=your_discord_bot_token_2_here
# ENABLE_FILTER_2=false

# ── Morning Reminder ─────────────────────────────────────────────────────────
# Discord Webhook URL for the target channel.
# Sends a daily message at 06:30 Asia/Taipei (GMT+8) with:
#   weather forecast, calendar ⭐ items, work shift reminder, and a must-bring checklist.
MORNING_REMINDER_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ── Google Calendar (optional, for ⭐ items + work reminders) ────────────────
# Obtain credentials at https://console.cloud.google.com/
#   1. Create an OAuth 2.0 Client ID (Desktop app)
#   2. Run the OAuth flow once to get a refresh token (see README for helper script)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_CALENDAR_ID=primary   # or a specific calendar ID
