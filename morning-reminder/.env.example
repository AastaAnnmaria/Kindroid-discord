# --- Morning reminder configuration ---
# Copy to .env for local testing (the .env file is gitignored).
# In production these are set as Cloud Function environment variables.

# Discord channel webhook URL (Channel Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# Google Calendar "Secret address in iCal format" URLs
# (Calendar settings -> Integrate calendar -> Secret address in iCal format)
# Courses calendar: the class schedule whose descriptions contain *記得帶...
ICAL_COURSES_URL=https://calendar.google.com/calendar/ical/.../basic.ics
# Primary calendar: where your 上班 (work) events live
ICAL_PRIMARY_URL=https://calendar.google.com/calendar/ical/.../basic.ics

# Optional: any extra calendars to also scan (comma-separated)
# ICAL_EXTRA_URLS=https://.../basic.ics,https://.../basic.ics
